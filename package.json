{
  "name": "@561-group/site",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Deployable 561.group apex site.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/561-group/561-group-site.git"
  },
  "scripts": {
    "build:worker": "node scripts/build-worker.mjs",
    "build:cloud-run": "node scripts/build-cloud-run.mjs",
    "project:mud-territory": "pnpm -r list --depth -1 --json | node scripts/project-workspace-territory.mjs",
    "cloudflare:preflight": "node scripts/cloudflare-deployment.mjs preflight",
    "cloudflare:deploy": "node scripts/cloudflare-deployment.mjs deploy",
    "cloudflare:deploy:dry-run": "node scripts/cloudflare-deployment.mjs dry-run",
    "cloudflare:reauthorize": "authenticate-linux-colony-with-cloudflare ops/cloudflare-authentication-request.json",
    "serve": "node src/server.ts",
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit && node --check scripts/cloudflare-deployment.mjs && node --test test/*.test.mjs",
    "verify:ephemeris-offer": "node scripts/verify-ephemeris-offer.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.1",
    "@harmonious-union/inference-work-lot-service": "4.0.1",
    "@lenticule-science/articulating": "0.1.1",
    "@red-cup-engineering/ethereum-services-section": "0.7.2",
    "@red-cup-engineering/modeled-union-dimension": "0.1.4",
    "@red-cup-engineering/rmn-semantic-conformance": "6.0.2",
    "@red-cup-engineering/typed-resource-catalog": "0.1.2",
    "@red-cup-engineering/561-group-website-theme": "0.0.2",
    "@red-cup-engineering/http-server": "0.0.2",
    "@red-cup-engineering/organizing-with-the-semantic-web": "0.0.1",
    "@red-cup-engineering/web-gui-services-section": "github:red-cup-engineering/web-gui-services-section#v0.1.1"
  },
  "devDependencies": {
    "@red-cup-engineering/linux-cloudflare-authentication-service": "0.1.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "wrangler": "4.114.0"
  },
  "sideEffects": false,
  "keywords": [
    "sovereign-state-enterprise",
    "open-source",
    "x402",
    "sponsorship"
  ]
}
