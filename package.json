{
  "name": "@561-group/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deployable 561.group apex site.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/561-group/561-group-site.git"
  },
  "scripts": {
    "build:worker": "node scripts/build-worker.mjs",
    "build:cloud-run": "node scripts/build-cloud-run.mjs",
    "project:mud-territory": "pnpm -r list --depth -1 --json | node scripts/project-workspace-territory.mjs",
    "cloudflare:preflight": "node scripts/cloudflare-deployment.mjs preflight",
    "cloudflare:deploy": "node scripts/cloudflare-deployment.mjs deploy",
    "cloudflare:deploy:dry-run": "node scripts/cloudflare-deployment.mjs dry-run",
    "cloudflare:reauthorize": "authenticate-linux-colony-with-cloudflare ops/cloudflare-authentication-request.json",
    "serve": "node src/server.ts",
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit && node --check scripts/cloudflare-deployment.mjs && node --test test/*.test.mjs",
    "verify:ephemeris-offer": "node scripts/verify-ephemeris-offer.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/a2a-rmn-part-service": "workspace:*",
    "@harmonious-union/inference-work-lot-service": "workspace:*",
    "@lenticule-science/articulating": "workspace:*",
    "@red-cup-engineering/ethereum-services-section": "workspace:*",
    "@red-cup-engineering/modeled-union-dimension": "workspace:*",
    "@red-cup-engineering/rmn-semantic-conformance": "workspace:*",
    "@red-cup-engineering/typed-resource-catalog": "workspace:*",
    "@red-cup-engineering/561-group-website-theme": "0.0.1",
    "@red-cup-engineering/http-server": "0.0.0",
    "@red-cup-engineering/organizing-with-the-semantic-web": "0.0.0"
  },
  "devDependencies": {
    "@red-cup-engineering/linux-cloudflare-authentication-cell": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "wrangler": "4.114.0"
  },
  "sideEffects": false,
  "keywords": [
    "sovereign-state-enterprise",
    "open-source",
    "x402",
    "sponsorship"
  ],
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "561-group",
    "kind": "capability-cell",
    "actor": "urn:ame:site",
    "operations": ["project-modeled-union-dimension", "preflight-cloudflare-deployment", "deploy-cloudflare-worker"],
    "capabilities": [{
      "capability": "modeled-union-dimension-browser-face",
      "faces": ["gui.561.group", "restricted-arena", "gyrobifastigium-j26", "four-charge"]
    }, {
      "capability": "cloudflare-worker-projection",
      "faces": ["named-profile", "linux-secret-service", "typed-authentication-refusal", "gui.561.group"]
    }],
    "package": "@561-group/site"
  }
}
